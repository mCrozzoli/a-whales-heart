// GENERATED by tools/build_web.py from supercollider/whaleheart.scd. Edit that file, then rebuild.
/*
 * A Whale's Heart — SuperCollider v0.12
 * Cmd+A → Cmd+Return
 *
 * SC is purely reactive — plays heartbeat on /whale/gate.
 * Speaker mode is runtime-switchable via /whale/setmode (stereo|quad).
 *
 * Output bus layout (always 4 buses internally; on a stereo audio
 * device, buses 2/3 simply route nowhere):
 *      [0] FL    [1] FR
 *      [2] RL    [3] RR
 *
 * Stereo mode → \heartbeat_stereo writes Pan2 to buses 0/1 only.
 * Quad mode   → \heartbeat_quad writes bilinear gains to all four.
 *
 * Future: for hexagonal/radial speaker arrays, replace the bilinear
 * formula in \heartbeat_quad with VBAP or angular crossfades using
 * atan2(spatY, spatX) and each speaker's azimuth.
 */
(
var root, bufPath;
// web: no file system; engine.js decodes whale_one_heart.wav and fills ~hbBuf.
// v0.12 — always 4 internal output buses. On a 2-channel audio device
// the extra buses route nowhere (Core Audio handles this gracefully).
// On a 4-channel device (UMC404), all four are wired to FL/FR/RL/RR.
s.options.numOutputBusChannels = 2;  // web: the browser gives two channels
// Disable inputs entirely — we never read audio in. This also avoids the
// macOS Core Audio restriction that input/output must be the same device
// (which previously caused AudioDeviceStart to fail when the UMC404 was
// plugged in but the system default mic was still MacBook Pro Microphone).
s.options.numInputBusChannels = 0;

// Pin both input and output to the UMC404 when it's connected. This is
// required on macOS Core Audio: SC's single `device` option forces in/out
// to the same physical device, which is the only configuration the OS
// permits without an aggregate device. The UMC has 4 ins + 4 outs so it
// satisfies both halves. If you ever run *without* the UMC, comment this
// line out — SC will then use the system default (laptop speakers).
// To list devices in SC IDE: ServerOptions.devices.do { |d| d.postln }
s.options.memSize = 2048;  // web: leaves room in scsynth's 16 MiB heap

s.waitForBoot {
    "─────────────────────────────────".postln;
    "  A Whale's Heart  v0.12".postln;
    "─────────────────────────────────".postln;

    // web: engine.js sets ~webSeconds, then fills this buffer from the page.
    ~hbBuf = Buffer.alloc(s, (~webSeconds * s.sampleRate).round.asInteger, 2);

    // ── Stereo SynthDef.
    // spatX drives L/R via equal-power Pan2; spatY is ignored.
    // Lifetime: env's gate=0 is the only freeSelf trigger. PlayBuf has no
    // doneAction — it just outputs silence after the buffer ends — so the
    // synth stays alive between beats and the next gate can release it
    // cleanly. (Previously: Done.freeSelf on PlayBuf killed the synth at
    // end-of-sample, then set(\gate,0) on the dead node = FAILURE in log.)
    SynthDef(\heartbeat_stereo, { |out=0, buf=0, amp=0.5, rate=1.0, gate=1, spatX=0.0, spatY=0.0|
        var sig, env, stereo;
        sig = PlayBuf.ar(2, buf, BufRateScale.kr(buf) * rate);
        sig = Mix.ar(sig);
        env = EnvGen.kr(Env.asr(0.005, 1.0, 0.08), gate, doneAction: Done.freeSelf);
        sig = sig * amp * env;
        stereo = Pan2.ar(sig, spatX.clip(-1, 1));
        Out.ar(out, stereo); // buses 0/1 = FL/FR
    }).add;

    // ── Quad SynthDef — bilinear (grid) panning across 4 speakers.
    // Each speaker's gain = product of two 1D pans (X × Y).
    // spatX: -1 west / +1 east  →  L vs R
    // spatY: -1 south / +1 north →  rear vs front (north = front)
    // Center (0,0) → equal -6dB on all four; corners → full on one speaker.
    SynthDef(\heartbeat_quad, { |out=0, buf=0, amp=0.5, rate=1.0, gate=1, spatX=0.0, spatY=0.0|
        var sig, env, x, y, gFL, gFR, gRL, gRR;
        // Same lifetime model as \heartbeat_stereo: env-only freeSelf.
        sig = PlayBuf.ar(2, buf, BufRateScale.kr(buf) * rate);
        sig = Mix.ar(sig);
        env = EnvGen.kr(Env.asr(0.005, 1.0, 0.08), gate, doneAction: Done.freeSelf);
        sig = sig * amp * env;
        x = spatX.clip(-1, 1);
        y = spatY.clip(-1, 1);
        gFL = ((1 - x) * 0.5) * ((1 + y) * 0.5);
        gFR = ((1 + x) * 0.5) * ((1 + y) * 0.5);
        gRL = ((1 - x) * 0.5) * ((1 - y) * 0.5);
        gRR = ((1 + x) * 0.5) * ((1 - y) * 0.5);
        Out.ar(out, [sig * gFL, sig * gFR, sig * gRL, sig * gRR]);
    }).add;

    SynthDef(\ocean, { |out=0, amp=0.025|
        var sig = LPF.ar(PinkNoise.ar(1), LFNoise1.kr(0.07).range(20,100)) * amp;
        Out.ar(out, sig ! 4);
    }).add;

    s.sync;

    ~currentBeat = nil;
    ~lastGateTime = nil;  // wall-clock debug
    ~speakerMode = \stereo;  // default; HTML overrides via /whale/setmode on sc_ready
    ~ocean.free;
    ~ocean = Synth(\ocean, [\out, 0, \amp, 0.025]);

    // ── GATE: fires at each depth inflection point ───────────
    // rate is already pre-multiplied by speed from HTML
    // surface: amp~1.0, rate~1.0×speed  → loud, fast, high
    // bottom:  amp~0.05, rate~0.25×speed → quiet, slow, low
    OSCdef(\whaleGate, { |msg|
        var amp, rate, gtype, depth, bpm, spatX, spatY;
        amp   = msg[1].asFloat;
        rate  = msg[2].asFloat;   // depth_rate × speed
        gtype = msg[3].asString;
        depth = msg[4].asFloat;
        bpm   = msg[5].asFloat;
        spatX = msg[6].asFloat;   // GPS longitude → -1..1
        spatY = msg[7].asFloat;   // GPS latitude  → -1..1 (unused in stereo)

        if (~currentBeat.notNil) {
            ~currentBeat.set(\gate, 0);
            ~currentBeat = nil;
        };

        ~currentBeat = Synth(
            if (~speakerMode == \quad) { \heartbeat_quad } { \heartbeat_stereo },
            [
                \buf,   ~hbBuf,
                \amp,   amp,
                \rate,  rate,
                \spatX, spatX,
                \spatY, spatY,
                \out,   0
            ]
        );

        // wall-clock delta between gates (diagnostic for double beats)
        // + per-mode routing diagnostics (visual confirmation when no quad rig)
        {
            var now = Main.elapsedTime * 1000;
            var dt  = if (~lastGateTime.notNil) { (now - ~lastGateTime).round } { 0 };
            var x, y, gFL, gFR, gRL, gRR, ang;
            ~lastGateTime = now;
            "[SC gate] dt=%ms  [%] %m  % bpm  amp:% rate:%".format(
                dt, gtype, depth.round(0.1), bpm.round(0.1),
                amp.round(0.01), rate.round(0.01)
            ).postln;

            // Show what the SynthDef is actually doing with the panning data.
            x = spatX.clip(-1, 1);
            y = spatY.clip(-1, 1);
            if (~speakerMode == \quad) {
                gFL = ((1 - x) * 0.5) * ((1 + y) * 0.5);
                gFR = ((1 + x) * 0.5) * ((1 + y) * 0.5);
                gRL = ((1 - x) * 0.5) * ((1 - y) * 0.5);
                gRR = ((1 + x) * 0.5) * ((1 - y) * 0.5);
                "          [QUAD] x=% y=%  →  FL:% FR:% RL:% RR:%".format(
                    x.round(0.01), y.round(0.01),
                    gFL.round(0.01), gFR.round(0.01),
                    gRL.round(0.01), gRR.round(0.01)
                ).postln;
            } {
                ang = (x + 1) * 0.25 * pi;  // 0..π/2
                "          [STEREO] x=%  →  L:% R:%  (rear: silent)".format(
                    x.round(0.01), cos(ang).round(0.01), sin(ang).round(0.01)
                ).postln;
            };
        }.value;

    }, '/whale/gate');

    OSCdef(\whalePause, {
        "  ■  pause".postln;
        if (~currentBeat.notNil) { ~currentBeat.set(\gate, 0); ~currentBeat = nil; };
    }, '/whale/pause');

    // End-of-track: silence heartbeat AND ocean bed.
    OSCdef(\whaleStop, {
        "  ◼  stop (end of track)".postln;
        if (~currentBeat.notNil) { ~currentBeat.set(\gate, 0); ~currentBeat = nil; };
        if (~ocean.notNil) { ~ocean.free; ~ocean = nil; };
    }, '/whale/stop');

    OSCdef(\whalePlay, {
        "  ♥  play".postln;
        // Restart ocean if a prior /whale/stop freed it.
        if (~ocean.isNil) { ~ocean = Synth(\ocean, [\out, 0, \amp, 0.025]); };
    }, '/whale/play');

    // Live speaker mode switch — incoming string \stereo or \quad.
    // Takes effect on the next gate; current ringing beat is unaffected.
    OSCdef(\whaleSetMode, { |msg|
        var mode = msg[1].asString.asSymbol;
        if ((mode == \stereo) or: { mode == \quad }) {
            // Skip the verbose banner if mode hasn't actually changed —
            // the HTML resyncs on every sc_ready, would otherwise spam.
            if (~speakerMode != mode) {
                ~speakerMode = mode;
                "═════════════════════════════════".postln;
                "  ↻  SPEAKER MODE  →  %".format(mode.asString.toUpper).postln;
                if (mode == \quad) {
                    "     SynthDef: \\heartbeat_quad".postln;
                    "     Routing:  bus 0 = FL    bus 1 = FR".postln;
                    "               bus 2 = RL    bus 3 = RR".postln;
                    "     Pan law:  bilinear (X × Y)".postln;
                    "     spatX:    -1 west  →  +1 east".postln;
                    "     spatY:    -1 south →  +1 north".postln;
                } {
                    "     SynthDef: \\heartbeat_stereo".postln;
                    "     Routing:  bus 0 = L     bus 1 = R".postln;
                    "               buses 2/3 unused".postln;
                    "     Pan law:  Pan2 (equal-power)".postln;
                    "     spatX:    -1 left   →  +1 right".postln;
                    "     spatY:    ignored".postln;
                };
                "═════════════════════════════════".postln;
            } {
                ~speakerMode = mode;  // reaffirm; no log spam
            };
        } {
            "  !  unknown speaker mode: %".format(mode).postln;
        };
    }, '/whale/setmode');

    ~whaleReady = true;  // web: engine.js polls this
    "─────────────────────────────────".postln;
    "  SC ready. Gate-driven playback.".postln;
    "  rate = depth_rate × speed".postln;
    "─────────────────────────────────".postln;
};
)
